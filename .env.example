# URL pública do projeto (ex.: na Vercel ou localhost)
PUBLIC_BASE_URL=https://seu-projeto.vercel.app

# Configurações do Banco PostgreSQL / Supabase
# Se DB_DISABLED=true, o servidor utiliza o banco em memória local (local-db.js) sem abrir conexões externas.
DB_DISABLED=true
DATABASE_URL=postgresql://postgres:senha@db.exemplo.supabase.co:5432/postgres
SUPABASE_POOLER_URL=postgresql://postgres.ref:senha@aws-0-region.pooler.supabase.com:6543/postgres
DB_CONNECTION_LIMIT=1
DB_IDLE_TIMEOUT=10000

# Autenticação do Painel Administrativo
ADMIN_JWT_SECRET=porto-admin-secret-change-me

# Configurações SMTP para envio de e-mails de confirmação
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app-do-gmail
EMAIL_FROM="Qualifica Vix <seu-email@gmail.com>"

# Integração WhatsApp / SMS via Twilio (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
