# URL pública do projeto (ex.: na Vercel ou localhost)
PUBLIC_BASE_URL=https://seu-projeto.vercel.app

# Firebase Realtime Database (cadastros acessados somente pelo servidor)
DB_PROVIDER=firebase
FIREBASE_PROJECT_ID=vixcursos
FIREBASE_DATABASE_URL=https://vixcursos-default-rtdb.firebaseio.com
# Caminho local, fora do repositório. Nunca publique a conta de serviço.
GOOGLE_APPLICATION_CREDENTIALS=C:/caminho/firebase-service-account.json
# Em hospedagem, use GOOGLE_APPLICATION_CREDENTIALS ou configure o JSON como segredo do servidor:
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Authentication: e-mail/senha, acesso administrativo restrito por UID
# O UID informado já está autorizado em server/admin-access.json.
# Opcional: substitua a lista padrão com UIDs separados por vírgula.
FIREBASE_ADMIN_UIDS=iGk2qpWxw6T1qv9PlOMuuEJnVk23

# Configurações SMTP para envio de e-mails de confirmação
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app-do-gmail
EMAIL_FROM="Qualifica Vix <seu-email@gmail.com>"

# Integração WhatsApp / SMS via Twilio (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
