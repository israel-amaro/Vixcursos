{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/admin", "destination": "/admin/login.html", "permanent": false },
    { "source": "/admin/", "destination": "/admin/login.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/public/:path*", "destination": "/api/index.js" },
    { "source": "/cursos/:path*", "destination": "/api/index.js" },
    { "source": "/inscritos/:path*", "destination": "/api/index.js" },
    { "source": "/inscricao", "destination": "/api/index.js" },
    { "source": "/chat", "destination": "/api/index.js" },
    { "source": "/certificado/:path*", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
